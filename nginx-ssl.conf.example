# Example nginx TLS terminator in front of the dashboard container.
# The nginx equivalent of Caddyfile.example.
#
# This edge proxy does ONE job: terminate TLS and forward everything —
# SPA assets and /v1/* API calls alike — to the dashboard container. The
# container's own bundled nginx (default.conf.template inside the image)
# handles the /v1/* split between the admin plane (:7979) and the runtime
# plane (:7878), serves the SPA, and sets security/cache headers.
#
# Do NOT proxy /v1/ from here straight to a backend plane: that bypasses
# the admin/runtime routing split, and a variable-based proxy_pass WITH a
# URI part would reintroduce the path-stripping regression documented in
# default.conf.template and OPERATIONS.md ("Reverse-proxy wiring").
#
# Replace admin.example.com and the certificate paths. "dashboard" is the
# compose service name — adjust host/port if the container lives elsewhere.

server {
    listen 443 ssl;
    server_name admin.example.com;
    server_tokens off;

    ssl_certificate     /etc/ssl/certs/dashboard.crt;
    ssl_certificate_key /etc/ssl/private/dashboard.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Modern clients pick the best cipher themselves; forcing server order
    # is a legacy-client mitigation that no longer helps.
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS is set here (the TLS hop), not in the container, which serves
    # plain HTTP behind the terminator. Keep the `preload` token: domains
    # on the hstspreload.org list must serve it or they become ineligible
    # and can be dropped from the list.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    location / {
        # Re-resolve "dashboard" per request instead of pinning its IP at
        # startup: a static `proxy_pass http://dashboard:80;` is resolved
        # ONCE when nginx starts, so recreating the dashboard container
        # (new IP) 502s until the edge restarts — and the edge fails to
        # start at all if the container isn't resolvable yet. Routing the
        # name through a variable forces per-request resolution against
        # the resolver below (127.0.0.11 is Docker's embedded DNS) and
        # lets nginx start independently of the container.
        #
        # This is SAFE from the variable+URI path-stripping pitfall warned
        # about above: the variable value contains NO URI part, and nginx
        # passes the original request URI unchanged when proxy_pass has no
        # URI. Deployments outside Docker should point `resolver` at their
        # host resolver — or drop the variable pattern entirely and use a
        # static proxy_pass.
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $dashboard_upstream http://dashboard:80;
        proxy_pass $dashboard_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name admin.example.com;
    return 301 https://$host$request_uri;
}
