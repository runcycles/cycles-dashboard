# X-Forwarded-Proto must PASS THROUGH the value set by the TLS terminator
# in front of this container (nginx-ssl.conf.example / Caddyfile). This
# nginx listens on plain :80, so $scheme here is always "http" — setting
# the header from $scheme would clobber the edge's "https" and make the
# backends see every request as insecure. Only fall back to $scheme when
# no terminator set the header (direct-to-container deployments).
#
# TRUST BOUNDARY: the pass-through is only trustworthy behind a TLS
# terminator that overwrites forwarded headers from untrusted clients.
# The shipped prod topology does — Caddy replaces incoming X-Forwarded-*
# from untrusted clients by default, and nginx-ssl.conf.example sets the
# header explicitly. If this container is exposed directly instead, the
# header is client-controlled: a plain-HTTP caller can claim "https" and
# the backends will believe it. Direct-to-container exposure is dev-only
# (the dev compose binds every port to loopback); production must sit
# behind a terminator that owns this header.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Security headers. Shared include (security-headers.conf) because
    # add_header in a location block cancels ALL inherited add_header
    # directives — every location below that sets its own header must
    # re-include the snippet or the security headers vanish there.
    include /etc/nginx/snippets/security-headers.conf;
    # Note: HSTS header belongs in the TLS config (nginx-ssl.conf.example /
    # Caddyfile.example), not here on port 80

    # Compress text assets. text/html is always included by nginx.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types application/javascript text/javascript text/css application/json image/svg+xml application/wasm application/manifest+json;

    # Proxy failures (upstream plane down / unreachable) return a JSON
    # ErrorResponse-shaped body instead of nginx's default HTML error page,
    # so /v1/* API callers can always parse the error. Served as a static
    # file so the original 502/503/504 status code is preserved.
    # proxy_intercept_errors stays off — error bodies produced by the
    # upstreams themselves pass through untouched.
    error_page 502 503 504 /50x.json;
    location = /50x.json {
        internal;
    }

    # SPA routing — serve index.html for all non-file routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html must never be served stale: the build embeds hashed asset
    # URLs and SRI integrity hashes (vite-plugin-sri-gen), so a heuristically
    # cached index.html from before a deploy both 404s (old hashed assets are
    # purged) and hard-fails integrity checks. no-cache forces revalidation
    # on every load while still allowing conditional (304) requests.
    # try_files' internal redirect for SPA routes re-runs location matching
    # and lands here too, so the fallback gets the same header.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Hashed build assets are content-addressed — safe to cache forever.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Reverse proxy API calls.
    # Runtime-plane endpoints (reservations) go to the runtime server.
    # Everything else on /v1/* goes to the admin server.
    #
    # Upstreams are injected at container start via envsubst from the
    # ADMIN_UPSTREAM / RUNTIME_UPSTREAM environment variables (defaults
    # baked into the Dockerfile: http://cycles-admin:7979 and
    # http://cycles-server:7878). Override them to retarget the bundled
    # proxy at deploy time — no file edit, no image rebuild. nginx's own
    # runtime variables ($upstream, $request_uri, $host, …) are left
    # untouched because the entrypoint only substitutes vars present in
    # the environment.
    #
    # Uses variables so nginx starts even if upstream is not yet resolvable.
    location ~ ^/v1/reservations(/|$) {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $upstream ${RUNTIME_UPSTREAM};
        proxy_pass $upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Evidence envelope retrieval + signer JWKS are runtime-plane
    # (cycles-server), like reservations. Public endpoints; routed through
    # the same proxy so the dashboard fetches them same-origin (the CSP
    # connect-src 'self' otherwise blocks a cross-origin fetch).
    location ~ ^/v1/(evidence(/|$)|\.well-known/cycles-jwks\.json$) {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $upstream ${RUNTIME_UPSTREAM};
        proxy_pass $upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /v1/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $upstream ${ADMIN_UPSTREAM};
        # $request_uri preserves the full original path + query string.
        # Must be used (not a literal /v1/ suffix) because nginx does not
        # perform automatic URI substitution on proxy_pass when the target
        # contains a variable — the literal suffix would send just "/v1/"
        # to the upstream and strip the rest of the path. This bug was
        # masked in Vite dev (different proxy implementation) but broke
        # every non-reservations /v1/* call through the prod nginx.
        proxy_pass $upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
}
